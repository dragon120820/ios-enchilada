+/*
+ * Eight blocks across the bottom edge, filled left to right and wrapping every
+ * second: one photograph then shows both that the timer runs and roughly how
+ * long the boot has been sitting there.
+ */
+static void
+sweet_fb_paint_beat(AppleCLCD *fb, uint64_t tick)
+{
+	if (fb->fPixels == 0 || fb->fWidth == 0 || fb->fHeight < SWEET_FB_BEAT_ROWS) {
+		return;
+	}
+	uint64_t step = tick / 60;                  /* ~1 s at the 16.67 ms tick */
+	uint32_t color = sweet_fb_beat_colors[step % SWEET_FB_BEAT_STEPS];
+	uint32_t blocks = (uint32_t)(step % (SWEET_FB_BEAT_STEPS + 1));
+	uint32_t width = fb->fWidth;
+	uint32_t cut = (uint32_t)(((uint64_t)blocks * width) / SWEET_FB_BEAT_STEPS);
+
+	for (uint32_t y = fb->fHeight - SWEET_FB_BEAT_ROWS; y < fb->fHeight; y++) {
+		volatile uint32_t *row = (volatile uint32_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes);
+		for (uint32_t x = 0; x < width; x++) {
+			row[x] = (x < cut) ? color : 0x00000000;
+		}
+	}
+}
