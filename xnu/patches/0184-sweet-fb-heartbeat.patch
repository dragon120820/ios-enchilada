@@ -89,6 +89,32 @@
 #define SWEET_FB_VSYNC_US               16667
 #define SWEET_FB_DOT_PITCH              458     /* ppi, as the iPhone X panel */
 /*
+ * sweetfb_beat=1 paints a bar along the bottom edge from the vsync timer.
+ * A boot that stops at the Apple logo otherwise looks identical whether the
+ * kernel died or the window server simply never drew; a bar that advances
+ * once a second tells the two apart from one photograph.  Default off, so a
+ * build without the boot-arg behaves exactly as before.
+ */
+static int sweet_fb_beat(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		on = 0;
+		(void)PE_parse_boot_argn("sweetfb_beat", &on, sizeof(on));
+	}
+	return on != 0;
+}
+
+#define SWEET_FB_BEAT_ROWS      12
+#define SWEET_FB_BEAT_STEPS     8
+
+static const uint32_t sweet_fb_beat_colors[SWEET_FB_BEAT_STEPS] = {
+	0x00ffffff, 0x0000ffff, 0x0000ff00, 0x000000ff,
+	0x00ffff00, 0x00ff00ff, 0x0000ffff, 0x00ffffff,
+};
+
+/*
  * sweetfb_stayon=1 makes the panel ignore backboardd's RequestPowerChange(0).
