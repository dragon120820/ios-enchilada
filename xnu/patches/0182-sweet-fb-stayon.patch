 /*
+ * sweetfb_stayon=1 makes the panel ignore backboardd's RequestPowerChange(0).
+ * 0079 gave the driver a real off state, but on this unit the power key does
+ * not bring the panel back (PLAN-ENCHILADA.md §3.3 I2), so auto-lock would end
+ * a test session in a black screen with no way out.  Default off keeps the
+ * daily-use behaviour.
+ */
+static int sweet_fb_stayon(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		on = 0;
+		(void)PE_parse_boot_argn("sweetfb_stayon", &on, sizeof(on));
+	}
+	return on != 0;
+}
+
