+/* PLAN-ENCHILADA.md §5 step 4: (2436 - 2280) rows of the logical plane have no
+ * panel behind them.  Centring the panel (fOffY = 78) leaves the home indicator
+ * 79 rows below the lowest touchable row, so a bottom swipe cannot start where
+ * iOS looks for it.  sweetfb_offy=N picks the split: 156 = panel at the bottom of
+ * the logical plane (gesture reachable, status bar lost), 78 = centred, 0 = panel
+ * at the top. */
+static int sweet_fb_offy(int logicalH, int panelH)
+{
+	int offy = (logicalH - panelH) / 2;
+	int want;
+
+	if (!PE_parse_boot_argn("sweetfb_offy", &want, sizeof(want)))
+		return offy;
+	if (want < 0 || want > logicalH - panelH)
+		return offy;
+	return want;
+}
+
